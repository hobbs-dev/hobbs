TARGET = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript.exe" "../tools/rustarch.R")
CARGO_TARGET_DIR = $(CURDIR)/rust-target
RUST_MANIFEST = ../inst/hobbs/Cargo.toml
RUST_EXE = $(CARGO_TARGET_DIR)/$(TARGET)/release/hobbs.exe
INST_RUST_EXE = ../inst/hobbs/bin/hobbs.exe
CRANFLAGS = -j 2

.PHONY: rust-sampler cleanup

all: cleanup

cleanup: $(SHLIB) rust-sampler
	rm -Rf $(CARGO_TARGET_DIR)

rust-sampler:
	mkdir -p ../inst/hobbs/bin
	PATH="$(USERPROFILE)\\.cargo\\bin:$(PATH)" rustc --version
	PATH="$(USERPROFILE)\\.cargo\\bin:$(PATH)" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" cargo build $(CRANFLAGS) --target=$(TARGET) --release --locked --manifest-path=$(RUST_MANIFEST)
	cp $(RUST_EXE) $(INST_RUST_EXE)
