TARGET = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript.exe" "../tools/rustarch.R")
CARGO_TARGET_DIR = $(CURDIR)/rust-target
RUST_MANIFEST = ../inst/hobbs/Cargo.toml
LIBDIR = $(CARGO_TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libhobbs.a
LAUNCHER = ../inst/hobbs/launcher.c
INST_RUST_EXE = ../inst/hobbs/bin/hobbs.exe
CRANFLAGS = -j 2
RUST_SYSTEM_LIBS = -lws2_32 -ladvapi32 -lgdi32 -lbcrypt -lcrypt32 -luserenv -lntdll

.PHONY: rust-sampler cleanup

all: cleanup

cleanup: $(SHLIB) rust-sampler
	rm -Rf $(CARGO_TARGET_DIR)

rust-sampler: $(STATLIB)
	mkdir -p ../inst/hobbs/bin
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) "$(LAUNCHER)" -o "$(INST_RUST_EXE)" -L"$(LIBDIR)" -lhobbs $(RUST_SYSTEM_LIBS)

$(STATLIB):
	PATH="$(USERPROFILE)\.cargo\bin:$(PATH)" cargo build $(CRANFLAGS) --target=$(TARGET) --release --locked --lib --manifest-path=$(RUST_MANIFEST)
