TARGET = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript.exe" "../tools/rustarch.R")
CARGO_TARGET_DIR = $(CURDIR)/rust-target
CARGO_HOME = $(CURDIR)/.cargo
RUST_MANIFEST = ../inst/hobbs/Cargo.toml
LIBDIR = $(CARGO_TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libhobbs.a
LAUNCHER = ../inst/hobbs/launcher.c
INST_RUST_EXE = ../inst/hobbs/bin/hobbs.exe
CRANFLAGS = -j 2
RUST_SYSTEM_LIBS = -lws2_32 -ladvapi32 -luserenv -ldbghelp -lbcrypt -lntdll -lgdi32 -lcrypt32

.PHONY: rust-sampler cleanup

all: cleanup

$(SHLIB): $(STATLIB)

$(STATLIB):
	mkdir -p $(CARGO_HOME)
	PATH="$(USERPROFILE)\.cargo\bin:$(PATH)" rustc --version
	CARGO_HOME="$(CARGO_HOME)" CARGO_TARGET_DIR="$(CARGO_TARGET_DIR)" PATH="$(USERPROFILE)\.cargo\bin:$(PATH)" cargo build $(CRANFLAGS) --target=$(TARGET) --release --locked --lib --manifest-path=$(RUST_MANIFEST); status=$$?; rm -Rf $(CARGO_HOME); exit $$status

rust-sampler: $(STATLIB)
	mkdir -p ../inst/hobbs/bin
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -static-libgcc "$(LAUNCHER)" -o "$(INST_RUST_EXE)" -L"$(LIBDIR)" -lhobbs $(RUST_SYSTEM_LIBS)

cleanup: $(SHLIB) rust-sampler
	rm -Rf $(CARGO_HOME) $(CARGO_TARGET_DIR)
